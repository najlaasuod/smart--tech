<?php
if (session_status() === PHP_SESSION_NONE) session_start();

function e($value){ return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8'); }
function is_logged_in(){ return isset($_SESSION['user_id']); }
function is_admin(){ return isset($_SESSION['role']) && $_SESSION['role'] === 'admin'; }
function redirect($path){ header('Location: ' . $path); exit; }
function require_login(){ if(!is_logged_in()) redirect('/smart-tech-project/auth/login.php'); }
function require_admin(){ require_login(); if(!is_admin()) redirect('/smart-tech-project/index.php'); }
function flash($key, $msg=null){
    if($msg !== null){ $_SESSION['flash'][$key] = $msg; return; }
    if(isset($_SESSION['flash'][$key])){ $m=$_SESSION['flash'][$key]; unset($_SESSION['flash'][$key]); return $m; }
    return null;
}
function upload_image($field, $old=null){
    if(empty($_FILES[$field]['name'])) return $old;
    $allowed = ['image/jpeg'=>'jpg','image/png'=>'png','image/webp'=>'webp'];
    $type = mime_content_type($_FILES[$field]['tmp_name']);
    if(!isset($allowed[$type])) return $old;
    if($_FILES[$field]['size'] > 2*1024*1024) return $old;
    $name = uniqid('prod_', true) . '.' . $allowed[$type];
    $dest = __DIR__ . '/../uploads/' . $name;
    move_uploaded_file($_FILES[$field]['tmp_name'], $dest);
    return 'uploads/' . $name;
}
?>
