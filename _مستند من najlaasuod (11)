<?php require_once '../config/database.php'; require_once '../includes/functions.php';
if($_SERVER['REQUEST_METHOD']==='POST'){
 $email=filter_var($_POST['email'],FILTER_VALIDATE_EMAIL); $pass=$_POST['password']??'';
 if(!$email || !$pass) flash('error','تأكد من إدخال البريد وكلمة المرور');
 else { $st=$pdo->prepare('SELECT * FROM users WHERE email=?'); $st->execute([$email]); $u=$st->fetch();
   if($u && password_verify($pass,$u['password'])){ session_regenerate_id(true); $_SESSION['user_id']=$u['id']; $_SESSION['name']=$u['name']; $_SESSION['role']=$u['role']; setcookie('smarttech_email',$email,time()+86400*7,'/'); redirect('../index.php'); }
   else flash('error','بيانات الدخول غير صحيحة'); }
}
include '../includes/header.php'; ?>
